# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/maple_payments
SPRING_DATASOURCE_USERNAME=maple_user
SPRING_DATASOURCE_PASSWORD=maple_password

# Kafka Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# SFTP Configuration
MAPLE_SFTP_HOST=localhost
MAPLE_SFTP_PORT=2222
MAPLE_SFTP_USERNAME=sftp_user
MAPLE_SFTP_PASSWORD=sftp_password
MAPLE_SFTP_REMOTE_DIR=/uploads

# HSM Configuration
MAPLE_HSM_MODE=simulated
MAPLE_HSM_KEY_ALIAS=maple-payment-signing-key

# Security Configuration
MAPLE_JWT_SECRET=your-secret-key-here-change-in-production
MAPLE_WEBHOOK_SECRET=your-webhook-secret-here-change-in-production

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_COM_MAPLE=DEBUG
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,prometheus,info

# File Storage
MAPLE_FILE_STORAGE_TYPE=local
MAPLE_FILE_STORAGE_LOCAL_PATH=./data/files
MAPLE_FILE_STORAGE_S3_BUCKET=maple-payments-files

# Payment Processing
MAPLE_PAYMENT_BATCH_SIZE=100
MAPLE_PAYMENT_BATCH_SCHEDULE=0 */30 * * * *
MAPLE_PAYMENT_APPROVAL_THRESHOLD_CENTS=10000000
